# Base URL of the deployed backend API (include the /api/v1 path).
NEXT_PUBLIC_API_BASE_URL=https://your-backend-domain.example.com/api/v1

# Base URL of this frontend itself, used for sitemap.xml/robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-frontend-domain.example.com

# Must be the exact same value as the backend's ACCESS_TOKEN_SECRET,
# so proxy.ts can verify access tokens issued by the backend.
JWT_ACCESS_SECRET=generate-a-long-random-string
